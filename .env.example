# Copy this file to .env. It is in .gitignore: never commit it.
#
# Spring reads it in .properties format, so write values without quotes and without $.

# HTTP port. The web and mobile clients call this one.
# SERVER_PORT=8080

# The public key of the security service: the same public.pem it is given. Absolute path, Java
# does not expand ~. Never the private key: the gateway refuses to start with it.
SECURITY_JWT_PUBLIC_KEY_PATH=/home/you/.energy-monitor/keys/public.pem

# The browser origins allowed to call the API, comma separated (the web app in development).
# Empty refuses every cross-origin caller. The services behind the gateway no longer answer CORS.
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:5173
# SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=

# Where the services listen.
SECURITY_SERVICE_URL=http://localhost:8082
DEVICE_SERVICE_URL=http://localhost:8084
MEASUREMENT_SERVICE_URL=http://localhost:8085
HOME_SERVICE_URL=http://localhost:8086
BACKEND_URL=http://localhost:8083

# Optional: timeouts towards the services and the limit of the public account endpoints.
# GATEWAY_CONNECT_TIMEOUT=2s
# GATEWAY_READ_TIMEOUT=30s
# GATEWAY_RATE_LIMIT_REQUESTS=20
# GATEWAY_RATE_LIMIT_WINDOW=1m
